# Copy to .env before running docker compose on a public host.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# AWS Bedrock cheque VLM. Credentials are optional here; the API falls back to
# deterministic image forensics plus manual review when Bedrock is unavailable.
AWS_REGION=us-east-1
BEDROCK_VLM_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_VLM_ENABLED=1
CHEQUE_VLM_BACKEND=auto
CHEQUE_MAX_IMAGE_MB=8
CHEQUE_AUDIT_PATH=models/cheque_audit.jsonl
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Artifact paths for online and federated learning.
ONLINE_MODEL_PATH=models/online_model.pkl
ONLINE_EVENT_LOG=models/online_events.jsonl
ONLINE_BOOTSTRAP_PATH=data/transactions.csv
FEDERATED_REPORT_PATH=models/federated_report.json
